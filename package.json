{
  "name": "walter",
  "displayName": "WALTER",
  "description": "Language support for WALTER",
  "publisher": "StanislavYegorov",
  "version": "0.0.1",
  "license": "MIT",
  "icon": "./assets/icons/extension-icon.png",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "WALTER",
    "REAPER"
  ],
  "main": "./out/src/extension.js",
  "type": "module",
  "scripts": {
    "lint": "eslint src",
    "watch": "tsc -watch -p ./",
    "compile": "tsc -p ./",
    "validate-syntax-grammar": "textmate-validate --verbose ./configs/syntax-patterns.json",
    "test-syntax-grammar": "vscode-tmgrammar-test testcases ./tests/**/*.test.txt -g ./configs/syntax-patterns.json",
    "pretest": "npm run compile && npm run lint",
    "test": "npm run validate-syntax-grammar && npm run test-syntax-grammar && vscode-test && tree-sitter test",
    "parser:build": "npm --prefix parser run generate && npm --prefix parser run build",
    "build": "npm run parser:build && npm run compile && npm run test",
    "package": "npm run build && vsce package"
  },
  "contributes": {
    "configuration": {
      "properties": {
        "WALTER.enableParser": {
          "type": "boolean",
          "default": true,
          "description": "Enables or disables the core feature of this extension (restart required)"
        },
        "WALTER.parserInterval": {
          "type": "number",
          "default": 200,
          "description": "Timeout between parsing events during typing (restart required)"
        }
      }
    },
    "commands": [
      {
        "command": "walter.printAst",
        "title": "Print AST",
        "when": "editorLangId == python"
      },
      {
        "command": "walter.printErrors",
        "title": "Print Errors",
        "when": "editorLangId == python"
      }
    ],
    "languages": [
      {
        "id": "walter",
        "filenames": [
          "rtconfig.txt"
        ],
        "icon": {
          "light": "./assets/icons/file-icon.png",
          "dark": "./assets/icons/file-icon.png"
        },
        "configuration": "./configs/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "walter",
        "scopeName": "source.walter",
        "path": "./configs/syntax-patterns.json"
      }
    ]
  },
  "dependencies": {
    "web-tree-sitter": "^0.26.13"
  },
  "devDependencies": {
    "@carlwr/textmate-validate": "^1.0.1",
    "@types/emscripten": "^1.41.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
