{
  "name": "WALTER",
  "displayName": "WALTER",
  "description": "Provides full feature support for WALTER language",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "scripts": {
    "validate-syntax-grammar": "textmate-validate --verbose ./configs/syntax-patterns.json",
    "test-syntax-grammar": "vscode-tmgrammar-test testcases ./tests/**/*.test.txt -g ./configs/syntax-patterns.json",
    "test": "npm run validate-syntax-grammar && npm run test-syntax-grammar && vscode-test",
    "lint": "eslint src",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint"
  },
  "contributes": {
    "commands": [
      {
        "command": "walter.helloWorld",
        "title": "Hello World"
      }
    ],
    "languages": [
      {
        "id": "walter",
        "aliases": [
          "WALTER",
          "walter"
        ],
        "filenames": [
          "rtconfig.txt"
        ],
        "configuration": "./configs/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "walter",
        "scopeName": "source.walter",
        "path": "./configs/syntax-patterns.json"
      }
    ]
  },
  "devDependencies": {
    "@carlwr/textmate-validate": "^1.0.1",
    "vscode-tmgrammar-test": "^0.1.3",
    "@types/vscode": "^1.134.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },

  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
