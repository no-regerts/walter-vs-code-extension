{
  "name": "walter",
  "displayName": "WALTER",
  "description": "Language support for WALTER",
  "publisher": "StanislavYegorov",
  "version": "1.2.0",
  "license": "MIT",
  "icon": "./assets/icons/extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/no-regerts/walter-vs-code-extension"
  },
  "bugs": {
    "url": "https://github.com/no-regerts/walter-vs-code-extension/issues"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Other"
  ],
  "keywords": [
    "WALTER",
    "REAPER"
  ],
  "main": "./generated/src/extension.js",
  "type": "module",
  "scripts": {
    "lint": "eslint src",
    "watch": "node esbuild.js --dev",
    "compile": "node esbuild.js --prod",
    "validate-syntax-grammar": "textmate-validate --verbose ./configs/syntax-patterns.json",
    "test-syntax-grammar": "vscode-tmgrammar-test testcases ./tests/**/*.test.txt -g ./configs/syntax-patterns.json",
    "pretest": "npm run compile && npm run lint",
    "test": "npm run validate-syntax-grammar && npm run test-syntax-grammar",
    "parser:build": "npm --prefix parser run generate && npm --prefix parser run build",
    "build": "npm run parser:build && npm run compile",
    "prepackage": "npm run test",
    "package": "npm run build && vsce pack --skip-license --out ./generated/"
  },
  "contributes": {
    "configuration": {
      "properties": {
        "walter.enableParser": {
          "type": "boolean",
          "default": true,
          "description": "Enables or disables the core feature of this extension (restart required)"
        },
        "walter.showDebugInfo": {
          "type": "boolean",
          "default": true,
          "description": "Enables or disables the debug mode (restart required)"
        },
        "walter.parserInterval": {
          "type": "number",
          "default": 200,
          "description": "Timeout between parsing events during typing"
        },
        "walter.linter.noTrailingSpaces": {
          "type": "boolean",
          "default": true,
          "description": "Underlines trailing spaces at the end of lines (restart required)"
        },
        "walter.linter.noDefCommands": {
          "type": "boolean",
          "default": true,
          "description": "Restricts the 'def' command usage (restart required)"
        },
        "walter.linter.noDashesInIdentifiers": {
          "type": "boolean",
          "default": true,
          "description": "Disallows dashes in identifiers (restart required)"
        },
        "walter.linter.noSingleEquals": {
          "type": "boolean",
          "default": true,
          "description": "Disallows single equals operator (restart required)"
        }
      }
    },
    "commands": [
      {
        "command": "walter.printAst",
        "title": "WALTER (DEBUG): Print AST"
      },
      {
        "command": "walter.printErrors",
        "title": "WALTER (DEBUG): Print Errors"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "walter.printAst",
          "when": "editorLangId == walter && config.walter.showDebugInfo == true"
        },
        {
          "command": "walter.printErrors",
          "when": "editorLangId == walter && config.walter.showDebugInfo == true"
        }
      ]
    },
    "languages": [
      {
        "id": "walter",
        "filenames": [
          "rtconfig.txt"
        ],
        "icon": {
          "light": "./assets/icons/file-icon.png",
          "dark": "./assets/icons/file-icon.png"
        },
        "configuration": "./configs/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "walter",
        "scopeName": "source.walter",
        "path": "./configs/syntax-patterns.json"
      },
      {
        "scopeName": "markdown.walter.codeblock",
        "path": "./configs/markdown-codeblock.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.walter": "walter"
        }
      }
    ]
  },
  "dependencies": {
    "web-tree-sitter": "^0.27.0"
  },
  "devDependencies": {
    "@carlwr/textmate-validate": "^1.0.1",
    "@types/emscripten": "^1.41.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "allowScripts": {
    "esbuild-plugin-copy@2.1.1": true,
    "@vscode/vsce-sign@2.1.0": true,
    "esbuild@0.28.2": true,
    "keytar@7.9.0": true
  }
}
