{
  "name": "WALTER",
  "displayName": "WALTER",
  "description": "Provides full feature support for WALTER language",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "walter",
        "aliases": [
          "WALTER",
          "walter"
        ],
        "filenames": [
          "rtconfig.txt"
        ],
        "configuration": "./configs/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "walter",
        "scopeName": "source.walter",
        "path": "./configs/syntax-patterns.json"
      }
    ]
  }
}
