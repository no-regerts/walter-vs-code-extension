{
  "comments": {
    "lineComment": {
      "comment": ";",
      "noIndent": false
    }
  },
  "folding": {
    "markers": {
      "start": ";region",
      "end": ";endregion"
    }
  },
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "`", "close": "`", "notIn": ["string"] }
  ]
}
