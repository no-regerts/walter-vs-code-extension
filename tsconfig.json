{
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "outDir": "generated",
    "types": [
      "node",
      "mocha",
      "emscripten"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ],
    "sourceMap": true,
    "rootDirs": [
      "./src",
      "./tests"
    ],
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true
  }
}
