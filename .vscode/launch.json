{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/tests/visual-test/base/rtconfig.txt",
        "${workspaceFolder}/tests/visual-test/default-theme/rtconfig.txt",
        "${workspaceFolder}/tests/visual-test/reatips/rtconfig.txt",
        "${workspaceFolder}/tests/visual-test/csix/rtconfig.txt"
      ],
      "outFiles": [
        "${workspaceFolder}/generated/**/*.js"
      ],
      "preLaunchTask": "build"
    }
  ]
}
