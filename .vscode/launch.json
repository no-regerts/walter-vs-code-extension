{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\nbsp(error|warning):\\nbsp(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[esbuild\\] Starting build\\.\\.\\.$",
          "endsPattern": "^\\[esbuild\\] Build finished\\!$"
        }
      }
    }
  ]
}