{
  "files.exclude": {
    "generated": false // set this to true to hide the "out" folder with the compiled JS files
  },
  "search.exclude": {
    "generated": true // set this to false to include "out" folder in search results
  },
  // Turn off tsc task auto detection since we have the necessary tasks as npm scripts
  "js/ts.tsc.autoDetect": "off"
}
